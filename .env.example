# ─── Docker Compose Variables ───
# These are interpolated into docker-compose.yaml
DB_PASSWORD="generate-strong-password-here"
POSTGRES_DB="arvesta_db"
POSTGRES_USER="postgres"

# ─── Local Dev (direct connection, not via Docker) ───
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/arvesta_db"

# ─── Auth ───
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://arvestafrance.com"
AUTH_TRUST_HOST="true"

# ─── Seed (optional, first deploy only) ───
# SEED_ADMIN_PASSWORD="your-admin-password"

# ─── Demo mode (optional) ───
# NEXT_PUBLIC_DEMO_MODE="true"
# DEMO_USERNAME="admin"
# DEMO_PASSWORD="your-demo-password"

# ─── SEO & Analytics ───
NEXT_PUBLIC_SITE_URL="https://arvestafrance.com"
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ─── Cloudflare Turnstile (CAPTCHA — contact form spam protection) ───
# Get from: https://dash.cloudflare.com → Turnstile → Sites
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key-here"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key-here"

# ─── NVIDIA AI (Qwen model for translations & content generation) ───
NVIDIA_API_KEY="your-nvidia-api-key-here"

# ─── OpenRouter AI (fallback when NVIDIA is unavailable) ───
OPENROUTER_API_KEY="your-openrouter-api-key-here"
